{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hexbeat.invalid/schemas/pattern-catalog.schema.json",
  "title": "HEXBEAT pattern catalog",
  "type": "object",
  "required": [
    "$schema",
    "schemaVersion",
    "patterns",
    "definitionFiles",
    "poolBands",
    "hardAdditions",
    "voidPool",
    "transitions",
    "selection",
    "generation"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": 1
    },
    "description": {
      "type": "string"
    },
    "patterns": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "definitionFiles": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "poolBands": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "maxX",
          "patterns"
        ],
        "properties": {
          "maxX": {
            "type": "number"
          },
          "patterns": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "hardAdditions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "minX",
          "patterns"
        ],
        "properties": {
          "minX": {
            "type": "number"
          },
          "patterns": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "voidPool": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "transitions": {
      "type": "object",
      "required": [
        "afterLadder",
        "afterBat"
      ],
      "properties": {
        "afterLadder": {
          "type": "object",
          "required": [
            "motifCount",
            "allowed",
            "finalAllowed",
            "triggerPatterns"
          ],
          "properties": {
            "motifCount": {
              "type": "integer",
              "minimum": 1
            },
            "allowed": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "finalAllowed": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "triggerPatterns": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "minItems": 1,
              "uniqueItems": true
            }
          }
        },
        "afterBat": {
          "type": "object",
          "required": [
            "motifCount",
            "allowed",
            "triggerPatterns"
          ],
          "properties": {
            "motifCount": {
              "type": "integer",
              "minimum": 1
            },
            "allowed": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "triggerPatterns": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "minItems": 1,
              "uniqueItems": true
            }
          }
        }
      }
    },
    "selection": {
      "type": "object",
      "required": [
        "recentPatternHistory",
        "historyLimit",
        "minimumWeight",
        "tagCooldowns",
        "tagWeights",
        "directionAlternation"
      ],
      "properties": {
        "recentPatternHistory": {
          "type": "integer",
          "minimum": 0
        },
        "historyLimit": {
          "type": "integer",
          "minimum": 1
        },
        "minimumWeight": {
          "type": "number",
          "minimum": 0
        },
        "tagCooldowns": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "tagWeights": {
          "type": "object",
          "additionalProperties": {
            "type": "number",
            "minimum": 0
          }
        },
        "directionAlternation": {
          "type": "object",
          "required": [
            "tag"
          ],
          "properties": {
            "tag": {
              "type": "string"
            }
          }
        },
        "feelModifiers": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "tag",
              "signal",
              "comparison",
              "threshold",
              "multiplier"
            ],
            "properties": {
              "tag": {
                "type": "string"
              },
              "signal": {
                "type": "string"
              },
              "comparison": {
                "enum": [
                  "above",
                  "below"
                ]
              },
              "threshold": {
                "type": "number"
              },
              "multiplier": {
                "type": "number",
                "minimum": 0
              }
            }
          }
        }
      }
    },
    "generation": {
      "type": "object",
      "required": [
        "reactionMarginSeconds",
        "defaultVoidGapBeats",
        "minimumPatternGapBeats",
        "defaultPatternGapBeats",
        "normalQuietThreshold",
        "hardQuietThreshold",
        "beatsPerBar",
        "nonContinuousGapBeats",
        "maxVoidMotifsPerChunk"
      ],
      "properties": {
        "reactionMarginSeconds": {
          "type": "number",
          "minimum": 0
        },
        "defaultVoidGapBeats": {
          "type": "number",
          "minimum": 0
        },
        "minimumPatternGapBeats": {
          "type": "number",
          "minimum": 0
        },
        "defaultPatternGapBeats": {
          "type": "number",
          "minimum": 0
        },
        "normalQuietThreshold": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "hardQuietThreshold": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "beatsPerBar": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "nonContinuousGapBeats": {
          "type": "number",
          "minimum": 0
        },
        "maxVoidMotifsPerChunk": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  },
  "additionalProperties": false
}
