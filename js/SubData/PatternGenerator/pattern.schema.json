{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hexbeat.invalid/schemas/pattern.schema.json",
  "title": "HEXBEAT pattern definition",
  "description": "One pattern factory expressed as ordered beat/Part data.",
  "type": "object",
  "required": [
    "$schema",
    "id",
    "name",
    "category",
    "description",
    "tags",
    "weight",
    "voidWeight"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-zA-Z0-9]*$"
    },
    "name": {
      "type": "string"
    },
    "category": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "weight": {
      "type": "number",
      "minimum": 0
    },
    "voidWeight": {
      "type": "number",
      "minimum": 0
    },
    "directionMode": {
      "enum": [
        "fixed",
        "relative",
        "by-direction"
      ]
    },
    "aliasOf": {
      "type": "string"
    },
    "repeatCount": {
      "type": "integer",
      "minimum": 1,
      "maximum": 12
    },
    "repeatTemplate": {
      "type": "object",
      "required": [
        "cycleBeats",
        "repeatArgument"
      ],
      "properties": {
        "cycleBeats": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "repeatArgument": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "parts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "beat"
        ],
        "properties": {
          "beat": {
            "type": "number",
            "minimum": 0
          },
          "openOffsets": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "integer"
            }
          },
          "openOffsetsByDirection": {
            "type": "object",
            "required": [
              "clockwise",
              "counterClockwise"
            ],
            "properties": {
              "clockwise": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "integer"
                }
              },
              "counterClockwise": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "integer"
                }
              }
            }
          },
          "randomSectorOffset": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "prefixItems": [
              {
                "type": "integer"
              },
              {
                "type": "integer"
              }
            ]
          },
          "wallSpanBeats": {
            "type": "number",
            "minimum": 0
          },
          "routeSpanBeats": {
            "type": "number",
            "minimum": 0
          }
        }
      }
    }
  },
  "anyOf": [
    {
      "required": [
        "parts"
      ]
    },
    {
      "required": [
        "aliasOf"
      ]
    }
  ],
  "additionalProperties": false
}
